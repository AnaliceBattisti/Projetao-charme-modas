generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Credenciais de acesso. Dados comerciais e pessoais da loja ficam em Cliente.
// Usuários internos podem existir sem cliente; contas públicas usam papel CLIENTE.
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     PapelUsuario @default(CLIENTE)
  criadoEm  DateTime @default(now())
  clienteId Int?     @unique

  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sessoes   SessaoUsuario[]
  recuperacaoSenha RecuperacaoSenha?
}

enum PapelUsuario {
  ADMIN
  OPERADOR
  CLIENTE
}

model SessaoUsuario {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  usuarioId  Int
  criadoEm   DateTime @default(now())
  expiraEm   DateTime

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model RecuperacaoSenha {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @unique
  tokenHash  String   @unique
  criadoEm   DateTime @default(now())
  expiraEm   DateTime

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
}

model Fornecedor {
  id           Int    @id @default(autoincrement())
  nomeRazaoSocial String
  cnpj         String @unique
  localizacao  String?
  categoria    String?
  telefone     String?
  email        String?

  produtos     Produto[]
}

model Produto {
  id            Int      @id @default(autoincrement())
  fornecedorId  Int
  nome          String
  descricao     String?
  marca         String?
  categoria     String?
  precoCusto    Decimal  @db.Decimal(10, 2)
  precoVenda    Decimal  @db.Decimal(10, 2)
  // Usado pela vitrine pra ordenar "Novidades" e marcar o selo NOVO.
  criadoEm      DateTime @default(now())

  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id])
  variacoes     Variacao[]
}

model Variacao {
  id             Int    @id @default(autoincrement())
  produtoId      Int
  cor            String?
  tamanho        String?
  sku            String? @unique
  // Não estava no diagrama original — necessário pro alerta de estoque
  // baixo/esgotado e pra guardar a quantidade atual sem recalcular
  // a partir do histórico de movimentações a cada consulta.
  estoqueMinimo  Int    @default(0)
  estoqueAtual   Int    @default(0)
  // Foto por variação (não por produto) — a cor muda a aparência da peça,
  // o tamanho não, então faz mais sentido a foto acompanhar cor+tamanho aqui.
  imagemUrl      String?

  produto              Produto @relation(fields: [produtoId], references: [id])
  movimentacoesEstoque MovimentacaoEstoque[]
  itensCompra          ItemCompra[]
}

model MovimentacaoEstoque {
  id         Int                     @id @default(autoincrement())
  variacaoId Int
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  // Não estava no diagrama original — usado pra descrever a movimentação
  // (ex.: "Chegada de mercadoria", "Venda #12", "Inventário - item danificado").
  motivo     String?
  data       DateTime                @default(now())

  variacao   Variacao @relation(fields: [variacaoId], references: [id])
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
}

model Cliente {
  id           Int     @id @default(autoincrement())
  nome         String
  cpf          String  @unique
  idade        Int?
  profissao    String?
  estadoCivil  String?
  telefone     String?
  email        String?

  usuario      Usuario?

  crediario    Crediario?
  compras      Compra[]
  enderecos    EnderecoCliente[]
}

model EnderecoCliente {
  id          Int     @id @default(autoincrement())
  clienteId   Int
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String

  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model Crediario {
  id            Int             @id @default(autoincrement())
  clienteId     Int             @unique
  limiteCredito Decimal         @db.Decimal(10, 2)
  limiteDisponivel Decimal      @db.Decimal(10,2)
  status        StatusCrediario @default(ATIVO)

  cliente       Cliente @relation(fields: [clienteId], references: [id])
}

enum StatusCrediario {
  ATIVO
  BLOQUEADO
}

model HistoricoLimiteCrediarioCliente {
  id            Int             @id @default(autoincrement())
  clienteId     Int 
  limiteAnterior Decimal         @db.Decimal(10, 2)
  limiteFinal Decimal         @db.Decimal(10, 2)
  motivo     String
  data       DateTime                @default(now())
}

model Compra {
  id             Int           @id @default(autoincrement())
  chavePedido    String?       @unique
  clienteId      Int
  data           DateTime      @default(now())
  valorTotal     Decimal       @db.Decimal(10, 2)
  formaPagamento String
  status         StatusCompra  @default(PENDENTE)

  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  itens          ItemCompra[]
  parcelas       Parcela[]
}

enum StatusCompra {
  SOLICITADA
  PENDENTE
  CONCLUIDA
  CANCELADA
}

model ItemCompra {
  id            Int     @id @default(autoincrement())
  compraId      Int
  variacaoId    Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)

  compra        Compra   @relation(fields: [compraId], references: [id])
  variacao      Variacao @relation(fields: [variacaoId], references: [id])
}

model Parcela {
  id             Int           @id @default(autoincrement())
  compraId       Int
  numero         Int
  valor          Decimal       @db.Decimal(10, 2)
  dataVencimento DateTime
  status         StatusParcela @default(PENDENTE)

  compra         Compra @relation(fields: [compraId], references: [id])
}

enum StatusParcela {
  PENDENTE
  PAGA
  ATRASADA
  CANCELADA
}

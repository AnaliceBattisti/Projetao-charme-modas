DATABASE_URL="postgresql://charme:charme@localhost:5432/charme_modas?schema=public"
PORT=3333
EXPOSICAO_CREDITO_CREDIARIO=150
LOJA_ORIGENS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174

# Recuperação de senha: mantenha apenas uma das opções abaixo ativa no .env.
# Opção 1 — caixa local Mailpit em http://localhost:8025 (padrão).
# Inicie com: docker compose -f docker-compose.mail.yml up -d
LOJA_URL=http://localhost:5174
EMAIL_FROM=contato@charme-modas.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Opção 2 — envio real pelo Gmail.
# Para usar, comente a opção 1 e descomente as linhas abaixo no .env.
# Substitua os exemplos pelo Gmail remetente e pela senha de aplicativo do Google.
# LOJA_URL=http://localhost:5174
# EMAIL_FROM=seuemail@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=COLE_A_SENHA_DE_APP_SEM_ESPACOS

# Em produção: domínio HTTPS da loja, remetente autorizado e SMTP real.
# Atualize LOJA_URL e LOJA_ORIGENS para o endereço público HTTPS da loja.
# SMTP_SECURE=true para porta 465; false com STARTTLS obrigatório para 587.
